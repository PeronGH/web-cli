{
  "name": "@peron_js/web-cli",
  "version": "2.2.1",
  "description": "A CLI to search and fetch the web",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PeronGH/web-cli.git",
    "directory": "packages/web-cli"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "web": "./dist/index.js"
  },
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/lib.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "start": "bun run src/cli/index.ts",
    "build": "bun run build:bin && bun run build:lib && bun run build:types",
    "build:bin": "bun build src/cli/index.ts --target node --outfile dist/index.js --minify",
    "build:lib": "bun build src/index.ts --target node --outfile dist/lib.js --packages external",
    "build:types": "tsc -p tsconfig.build.json",
    "prepublishOnly": "bun run build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "citty": "^0.2.2",
    "defuddle": "^0.19.4",
    "linkedom": "^0.18.13",
    "turndown": "^7.2.4"
  },
  "devDependencies": {
    "@types/turndown": "^5.0.6",
    "undici": "^8.10.0"
  }
}
